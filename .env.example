# ==========================================
# BINANCE SPOT TESTNET - CONFIGURATION TEMPLATE
# ==========================================

# Kunci API Binance Spot Testnet (Dapatkan gratis di https://testnet.binance.vision/)
BINANCE_API_KEY=your_binance_testnet_api_key_here
BINANCE_SECRET_KEY=your_binance_testnet_secret_key_here

# Daftar Koin yang Dipindai Secara Multi-Market (Watchlist)
WATCHLIST=BNB/USDT,SOL/USDT,XRP/USDT,ADA/USDT,DOGE/USDT,ETH/USDT,BTC/USDT
SYMBOL=SOL/USDT
TIMEFRAME=3m

# Pengaturan Strategi Trading (RSI / HYBRID / AI)
STRATEGY_TYPE=RSI
AI_CONFIDENCE_THRESHOLD=0.35

# Pengaturan Indikator RSI Cepat (Scalping Settings)
RSI_PERIOD=7
RSI_OVERSOLD=38.0
RSI_OVERBOUGHT=65.0

# Pengaturan Manajemen Risiko Scalping
MAX_BALANCE_RISK_PERCENT=10.0
TAKE_PROFIT_PERCENT=1.2
STOP_LOSS_PERCENT=1.0

# Pengaturan Eksekusi Bot
POLL_INTERVAL_SECONDS=5
IS_TESTNET=True
DRY_RUN=True
